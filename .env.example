# --- LLM provider (LiteLLM-backed; provider chosen by the model ids in config/, not code) ---
# Set the key for WHICHEVER provider your configured model ids use. Defaults use Anthropic.
# To run on another provider, change the model ids in config/settings.py and set its key here
# (e.g. OPENAI_API_KEY=... or GEMINI_API_KEY=...). The whole .env is loaded provider-neutrally.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- LangSmith (optional: tracing + eval runs). Leave TRACING=false to run without an account. ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=marquee

# --- Local stores (Plane 2 + Plane 3). Defaults work out of the box. ---
MARQUEE_DB_PATH=marquee.db
MARQUEE_CHROMA_DIR=.chroma

# --- Outbound safety: dry-run writes Gmail drafts only, never auto-sends. Keep true in dev. ---
MARQUEE_GMAIL_DRY_RUN=true
